{
  "name": "perspectives",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:all": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "build": "npm run typecheck && vite build && npm run build:api",
    "build:api": "npm --workspace apps/api run build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false && npm run typecheck:api",
    "typecheck:api": "tsc -p apps/api/tsconfig.json --pretty false",
    "test": "npm run test:web && npm run test:api",
    "test:web": "vitest run src/App.test.tsx",
    "test:api": "npm --workspace apps/api test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "react-router-dom": "latest",
    "@tanstack/react-query": "latest",
    "tailwindcss": "latest",
    "@tailwindcss/vite": "latest",
    "express": "latest",
    "cors": "latest",
    "helmet": "latest",
    "dotenv": "latest",
    "mongoose": "latest",
    "zod": "latest",
    "pino": "latest",
    "pino-http": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/express": "latest",
    "@types/cors": "latest",
    "@types/node": "latest",
    "@types/supertest": "latest",
    "@eslint/js": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "supertest": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "jsdom": "latest",
    "prettier": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest",
    "concurrently": "latest",
    "tsx": "latest"
  }
}
